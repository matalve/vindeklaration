__pycache__/
*.pyc
.venv/
.pytest_cache/

# Raw upstream responses: large, regenerable, not part of the published dataset.
data/cache/

# The published dataset: ~16 MB of JSON whose nightly commit would cost its
# near-full size in git history, forever. Published as build output instead —
# to the R2 bucket behind vindeklaration.se/data/ and to the rolling
# dataset-latest GitHub release. Rebuilt locally by src/build.py.
data/wines.json
data/catalog.json

# The gzipped copies update.sh uploads to R2 and the release. Written next to
# the originals on every run, so without this the crawler's tree never looks
# clean again.
data/wines.json.gz
data/catalog.json.gz

# Rebuilt from wines.json by src/build.py in seconds. Committing it costs its
# full 4 MB every night, because git cannot delta a binary the way it deltas
# the JSON. It is published as a release asset instead.
data/wines.sqlite

# Wrangler's local state and cache, written into the repository root whenever
# it runs — which update.sh now does nightly. The local-simulator storage under
# it is not the R2 bucket and holds nothing worth keeping.
.wrangler/

# Generated by src.site; rebuilt from wines.json in under a minute.
site/
